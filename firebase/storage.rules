rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Uygulamanın ürettiği görseller en fazla birkaç yüz KB; 5 MB güvenli üst sınır.
    function validImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /users/{userId}/players/{playerId}/{mediaFile} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && mediaFile in ['source.jpg', 'cutout.webp']
        && validImage();
    }

    match /users/{userId}/logos/{logoFile} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && logoFile in ['home.webp', 'away.webp']
        && validImage();
    }

    // Tanımlı olmayan her yol kapalı.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
