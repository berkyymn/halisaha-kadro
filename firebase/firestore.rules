rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanıcı başına tek poster dokümanı: posters/{uid}
    match /posters/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function optionalType(field, type) {
        return !request.resource.data.keys().hasAny([field])
          || (type == 'map' && request.resource.data[field] is map)
          || (type == 'string' && request.resource.data[field] is string
              && request.resource.data[field].size() <= 40)
          || (type == 'bool' && request.resource.data[field] is bool);
      }

      // İstemci her yazımda revision'ı transaction içinde tam 1 artırır;
      // eski sürümden gelen (stale) yazılar reddedilir.
      function validRevision() {
        return request.resource.data.revision is int
          && request.resource.data.revision
            == (resource == null ? 0 : resource.data.get('revision', 0)) + 1;
      }

      // Kötüye kullanım sınırları (uygulama yedeği 20 ile sınırlar; burası daha geniş).
      function validDataLimits() {
        let data = request.resource.data.data;
        return (!data.keys().hasAny(['savedPlayers'])
            || (data.savedPlayers is map && data.savedPlayers.size() <= 60))
          && (!data.keys().hasAny(['benchPlayerIds'])
            || (data.benchPlayerIds is list && data.benchPlayerIds.size() <= 40));
      }

      function validPoster() {
        return request.resource.data.keys().hasOnly([
            'data', 'branding', 'updatedAt', 'brandingUpdatedAt',
            'photosOmitted', 'logosOmitted', 'revision'
          ])
          && request.resource.data.data is map
          && validDataLimits()
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40
          && optionalType('branding', 'map')
          && optionalType('brandingUpdatedAt', 'string')
          && optionalType('photosOmitted', 'bool')
          && optionalType('logosOmitted', 'bool')
          && validRevision();
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && validPoster();
      // Uygulama içi "Hesabımı sil" (KVKK silme hakkı).
      allow delete: if isOwner();
    }

    // İletişim formu: herkes (misafir dahil) mesaj bırakabilir; kimse okuyamaz.
    // Mesajlar Firebase konsolundan okunur.
    match /feedback/{feedbackId} {
      function validFeedback() {
        let d = request.resource.data;
        return d.keys().hasOnly(['topic', 'message', 'email', 'signedIn', 'userAgent', 'createdAt'])
          && d.keys().hasAll(['topic', 'message', 'signedIn', 'createdAt'])
          && d.topic in ['oneri', 'hata', 'sikayet', 'diger']
          && d.message is string
          && d.message.size() >= 10
          && d.message.size() <= 2000
          && (!d.keys().hasAny(['email']) || (d.email is string && d.email.size() <= 120))
          && (!d.keys().hasAny(['userAgent']) || (d.userAgent is string && d.userAgent.size() <= 300))
          && d.signedIn is bool
          && d.createdAt == request.time;
      }

      allow create: if validFeedback();
    }

    // Anonim günlük kullanım sayacı (src/lib/usageStats.ts): herkes yalnızca
    // tanımlı alanları tam 1 artırabilir; kimse okuyamaz (konsoldan okunur).
    // Kimlik, IP ya da serbest metin yazılamaz.
    match /stats/{day} {
      function counters() {
        return ['sessions', 'sessions_mobile', 'posters', 'posters_mobile', 'download', 'whatsapp', 'instagram', 'x', 'copy', 'system', 'consent_granted', 'consent_denied'];
      }

      // Alan değişmediyse ya da tam 1 arttıysa geçerli.
      function bumped(field) {
        let before = resource == null ? 0 : resource.data.get(field, 0);
        let after = request.resource.data.get(field, 0);
        return after == before || (after is int && after == before + 1);
      }

      function validCounters() {
        return day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(counters())
          && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().size() <= 4
          && bumped('sessions')
          && bumped('sessions_mobile')
          && bumped('posters')
          && bumped('posters_mobile')
          && bumped('download')
          && bumped('whatsapp')
          && bumped('instagram')
          && bumped('x')
          && bumped('copy')
          && bumped('system')
          && bumped('consent_granted')
          && bumped('consent_denied');
      }

      allow create, update: if validCounters();
    }

    // Tanımlı olmayan her yol kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
